# Where the Vite dev server proxies `/metacensus/*` — i.e. service-api-standard
# or service-api-chain, each defaulting to PORT 3001.
# Dev-server-only (no VITE_ prefix, not exposed to the client). Defaults to
# http://localhost:3001 when unset.
API_PROXY_TARGET=http://localhost:3001

# Optional Comparanda reviewer workspace binding. Leave unset to hide reviewer
# run data. When a topic id is supplied, only that topic resolves the run.
VITE_REVIEWER_TOPIC_ID=
VITE_REVIEWER_RUN_ID=

# /reviewer-snapshots/ path (the export carries full text and PDFs). The UI
# appends /<run-id> and fetches manifest.json, review_units.json, rows/*,
# bundles/*, and PDFs.
VITE_REVIEWER_SNAPSHOT_BASE_URL=/reviewer-snapshots/dpyd

VITE_REVIEWER_INDEX_BASE_URL=/reviewer-snapshots/index

VITE_REVIEWER_NORMALIZATION_BASE_URL=/reviewer-snapshots/normalization
