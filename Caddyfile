# Static file host for the built SPA. Not an edge/reverse-proxy — routing
# fallback required by TanStack Router's client-side routing.
:8080 {
	root * /srv
	encode gzip

	# Fingerprinted build assets (Vite emits hashed filenames): cache hard and,
	# crucially, do NOT fall back to index.html — a missing/renamed chunk must
	# 404 loudly rather than return HTML served with a JS content-type.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: SPA history fallback so client-side routes (deep links,
	# refreshes) resolve to the app shell.
	handle {
		try_files {path} /index.html
		file_server
	}
}
