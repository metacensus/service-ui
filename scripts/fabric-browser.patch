+func TestImages_Browser(t *testing.T) {
+	script := os.Getenv("BROWSER_TEST_SCRIPT")
+	if script == "" {
+		t.Skip("set BROWSER_TEST_SCRIPT to the UI browser test")
+	}
+	origin := os.Getenv("SPA_ORIGIN")
+	if origin == "" {
+		t.Fatal("SPA_ORIGIN must name the browser's origin")
+	}
+	api, provision := startAPI(t, origin)
+	path := "/" + rand.Text()
+	mux := http.NewServeMux()
+	mux.HandleFunc("PUT "+path+"/{topic}", func(w http.ResponseWriter, r *http.Request) {
+		channel, err := channels.Topic(r.PathValue("topic"))
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		if err := provision(r.Context(), channel); err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		fmt.Fprint(w, channel)
+	})
+	control := httptest.NewServer(mux)
+	t.Cleanup(control.Close)
+	cmd := exec.CommandContext(t.Context(), "node", script, "--vote")
+	cmd.Env = append(os.Environ(), "API_PROXY_TARGET="+api.base, "PROVISION_TOPIC_URL="+control.URL+path)
+	cmd.Stdout, cmd.Stderr = os.Stdout, os.Stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatal(err)
+	}
+}
